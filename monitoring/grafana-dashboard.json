{
  "dashboard": {
    "title": "DINOForge Service Overview",
    "uid": "dinoforge-overview",
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Request Rate",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate(dinoforge_http_requests_total[5m])",
            "legendFormat": "{{method}} {{path}}"
          }
        ]
      },
      {
        "id": 2,
        "title": "Error Rate",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate(dinoforge_http_requests_total{status=~\"5..\"}[5m]) / rate(dinoforge_http_requests_total[5m])",
            "legendFormat": "Error %"
          }
        ]
      },
      {
        "id": 3,
        "title": "P50/P95/P99 Latency",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(dinoforge_tool_duration_seconds_bucket[5m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(dinoforge_tool_duration_seconds_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(dinoforge_tool_duration_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ]
      },
      {
        "id": 4,
        "title": "SLO Error Budget",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "dinoforge_slo_error_budget_remaining",
            "legendFormat": "{{slo}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "max": 1,
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 0.1
                },
                {
                  "color": "green",
                  "value": 0.5
                }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Tool Calls by Name",
        "type": "piechart",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "sum by (tool) (rate(dinoforge_tool_calls_total[5m]))",
            "legendFormat": "{{tool}}"
          }
        ]
      },
      {
        "id": 6,
        "title": "Game Launch Success Rate",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 16
        },
        "targets": [
          {
            "expr": "sum(dinoforge_game_launch_total{status=\"success\"}) / sum(dinoforge_game_launch_total) * 100",
            "legendFormat": "Success %"
          }
        ]
      },
      {
        "id": 7,
        "title": "Active Connections",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 16
        },
        "targets": [
          {
            "expr": "dinoforge_active_connections",
            "legendFormat": "Connections"
          }
        ]
      }
    ],
    "schemaVersion": 39
  },
  "overwrite": true
}